# Configurações do Banco de Dados MySQL (Produção)
DATABASE_URL=mysql+pymysql://usuario:senha@servidor:3306/boro

# Configurações do Redis
REDIS_URL=redis://localhost:6379/0

# Configurações do Ambiente
ENVIRONMENT=production
DEBUG=false

# Credenciais do Portal (serão carregadas do banco)
# PORTAL_USERNAME=será_carregado_do_banco
# PORTAL_PASSWORD=será_carregado_do_banco
PORTAL_URL=https://portal.e-fornecedores.ind.br/

# Configurações de Email
SMTP_SERVER=smtpi.uni5.net
SMTP_PORT=587
SMTP_USERNAME=envio@keven.dev.br
SMTP_PASSWORD=Secpol@2

# Configurações do Selenium
CHROME_HEADLESS=true
SELENIUM_TIMEOUT=30
SELENIUM_IMPLICIT_WAIT=10

# Configurações de Tarefas
TASK_INTERVAL_MINUTES=5
MAX_CONCURRENT_TASKS=3

# Configurações de Log
LOG_LEVEL=INFO
LOG_FILE=logs/portal_automation.log

# Configurações de Proxy (opcional)
# PROXY_SERVER=http://proxy:port
