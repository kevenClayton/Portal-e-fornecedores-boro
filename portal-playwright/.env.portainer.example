# Copie para o Portainer → Stacks → Add stack → Environment variables
# NÃO commite este arquivo com senhas reais.

CLIENTE=madeforte

DB_HOST=mysql.madeforte.maranatatecnologia.com.br
DB_PORT=3306
DB_USER=madeforte01
DB_PASSWORD=sua_senha
DB_NAME=madeforte01

PORTAL_URL=https://portal.e-fornecedores.ind.br/

# Proxy BR (recomendado se a AWS estiver nos EUA)
# PROXY=IP:PORTA:USUARIO:SENHA
PROXY=

HEADLESS=true
TEMPO_ESPERA=30

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Painel Laravel
PAINEL_PORT=8080
PAINEL_APP_URL=http://SEU_IP:8080
# Gere com: cd painel && php artisan key:generate --show
PAINEL_APP_KEY=
ADMIN_EMAIL=admin@madeforte.local
ADMIN_PASSWORD=troque_esta_senha
ROBO_USAR_DOCKER_CLI=true
ROBO_CONTAINER_NAME=portal-fornecedores
ROBO_PORTAINER_URL=
ROBO_PORTAINER_API_KEY=
ROBO_PORTAINER_ENDPOINT_ID=1

