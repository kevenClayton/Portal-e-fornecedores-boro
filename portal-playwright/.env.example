# Cliente ativo: madeforte | boro | rttransportes | jslogistica
CLIENTE=madeforte
# ID do cliente no banco multi-tenant (MadeForte = 1)
CLIENTE_ID=1

# Banco de dados MySQL (NOVO / destino)
DB_HOST=localhost
DB_PORT=3306
DB_USER=portal_user
DB_PASSWORD=sua_senha_aqui
DB_NAME=portal_fornecedores

# Banco legado (ORIGEM da migração — só para migrate.py)
LEGACY_DB_HOST=localhost
LEGACY_DB_PORT=3306
LEGACY_DB_USER=usuario_legado
LEGACY_DB_PASSWORD=senha_legado
LEGACY_DB_NAME=nome_banco_legado

# Portal E-Fornecedores (opcional — credenciais podem vir do banco tabela login)
PORTAL_URL=https://portal.e-fornecedores.ind.br/

# SMTP (notificações)
SMTP_HOST=smtpi.uni5.net
SMTP_PORT=587
SMTP_USER=envio@exemplo.com
SMTP_PASSWORD=sua_senha_smtp
SMTP_FROM=envio@exemplo.com

# WhatsApp (API ReservaAI) — telefones ficam em parametros no banco/painel
WHATSAPP_API_URL=https://api.reservaai.com.br/api
WHATSAPP_API_TOKEN=
PAINEL_URL_PUBLICA=https://madeforte.reservaai.com.br

# Proxy BR (recomendado se o servidor estiver nos EUA)
# Formato: IP:PORTA:USUARIO:SENHA   ou   IP:PORTA
# Exemplo:
# PROXY no .env é só fallback se a API Webshare falhar.
# Com WEBSHARE_API_TOKEN o robô escolhe/renova o IP sozinho (MadeForte e Boro em faixas diferentes).
# PROXY=198.23.239.134:6540:usuario:senha
PROXY=
PROXY_BORO=
WEBSHARE_API_TOKEN=
# Plano Webshare: 14238008=shared/proxy server (acessível da EC2) | 14263983=ISP static residential
WEBSHARE_PLAN_ID=14238008
# CloakBrowser Pro (não versionar a chave real)
CLOAKBROWSER_LICENSE_KEY=
USAR_CLOAKBROWSER=true
CLOAK_HUMANIZE=true
CLOAK_HUMAN_PRESET=careful
CLOAK_GEOIP=true

# Webshare — rotação automática de IP quando o captcha falhar
# Token: Dashboard Webshare → API
WEBSHARE_API_TOKEN=
# Opcional: ID do plano ISP/residential (vazio = detecta sozinho)
WEBSHARE_PLAN_ID=
